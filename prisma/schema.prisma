// Prisma schema for Recta - Personal Finance Backend
// Designed for PostgreSQL with explicit authorization model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  firebaseUid   String?  @unique @map("firebase_uid")
  passwordHash  String?  @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  email         String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // User preferences
  displayName                 String?   @map("display_name")
  isPremium                   Boolean   @default(true) @map("is_premium")
  onboardingCompleted         Boolean   @default(false) @map("onboarding_completed")
  onboardingRestartedAt       DateTime? @map("onboarding_restarted_at")
  theme                       String?   @default("light") // 'light' | 'dark'
  baseCurrency                String?   @default("BRL") @map("base_currency") @db.VarChar(3)
  locale                      String?   @default("pt-BR") @db.VarChar(10)
  country                     String?   @db.VarChar(2)
  referralCode                String?   @map("referral_code") @db.VarChar(20)
  dashboardPreferences        Json?     @map("dashboard_preferences")
  lastRecurringProcessedMonth String?   @map("last_recurring_processed_month") @db.VarChar(7)
  lastRecurringProcessedAt    DateTime? @map("last_recurring_processed_at")
  preferencesUpdatedAt        DateTime? @map("preferences_updated_at")

  // Relations
  householdMembers         HouseholdMember[]
  householdInvitesSent     HouseholdInvite[] @relation("Inviter")
  householdInvitesReceived HouseholdInvite[] @relation("Invitee")
  referralsAsReferrer      Referral[]        @relation("Referrer")
  referralsAsReferred      Referral?         @relation("Referred")
  notifications            Notification[]
  transactionSplits        TransactionSplit[]
  people                   Person[]
  capturedNotifications    CapturedNotification[]
  deviceTokens             DeviceToken[]

  @@map("users")
}

// ============================================================================
// HOUSEHOLD & MEMBERSHIP
// ============================================================================

enum HouseholdRole {
  OWNER
  EDITOR
  VIEWER
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  members               HouseholdMember[]
  invites               HouseholdInvite[]
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  recurringTransactions RecurringTransaction[]
  people                Person[]
  settlements           Settlement[]
  capturedNotifications CapturedNotification[]
  deviceTokens          DeviceToken[]
  captureAccountRules   CaptureAccountRule[]
  employments           Employment[]
  monthClosings         MonthClosing[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        HouseholdRole @default(VIEWER)
  allowPersonalAccountAccess Boolean @default(false) @map("allow_personal_account_access") // Allows other members to use this member's personal accounts in shared household transactions
  sharedAccountIds Json?     @default("[]") @map("shared_account_ids") // Array of account IDs that this member has specifically chosen to share (overrides allowPersonalAccountAccess when provided)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([householdId, userId])
  @@index([householdId])
  @@index([userId])
  @@map("household_members")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model HouseholdInvite {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  inviterId   String        @map("inviter_id") @db.Uuid
  inviteeId   String?       @map("invitee_id") @db.Uuid
  email       String
  role        HouseholdRole @default(VIEWER)
  status      InviteStatus  @default(PENDING)
  expiresAt   DateTime      @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  acceptedAt  DateTime?     @map("accepted_at")
  rejectedAt  DateTime?     @map("rejected_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inviter   User      @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   User?     @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([householdId, email, status])
  @@index([inviteeId])
  @@index([householdId])
  @@index([status])
  @@map("household_invites")
}

// ============================================================================
// FINANCIAL ENTITIES
// ============================================================================

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
  CASH
  INVESTMENT
}

model Account {
  id               String        @id @default(uuid()) @db.Uuid
  householdId      String        @map("household_id") @db.Uuid
  name             String
  type             AccountType
  balance          Decimal       @default(0) @db.Decimal(15, 2) // Mantido para compatibilidade (será total_balance)
  currency         String        @default("BRL") @db.VarChar(3)
  isActive         Boolean       @default(true) @map("is_active")
  status           AccountStatus @default(ACTIVE)
  color            String?       @db.VarChar(7) // Hex color
  icon             String? // Icon identifier
  // Balance fields - separação de saldos
  totalBalance     Decimal       @default(0) @map("total_balance") @db.Decimal(15, 2) // Saldo total (available + allocated)
  availableBalance Decimal       @default(0) @map("available_balance") @db.Decimal(15, 2) // Saldo disponível para uso
  allocatedBalance Decimal       @default(0) @map("allocated_balance") @db.Decimal(15, 2) // Saldo alocado como garantia
  // Credit card specific fields
  creditLimit      Decimal?      @map("credit_limit") @db.Decimal(15, 2) // Limite total do cartão
  totalLimit       Decimal?      @map("total_limit") @db.Decimal(15, 2) // Limite total (creditLimit + allocatedBalance)
  availableLimit   Decimal?      @map("available_limit") @db.Decimal(15, 2) // Limite disponível (totalLimit - dívida atual)
  dueDay           Int?          @map("due_day") // Day of month (1-31) - vencimento da fatura
  closingDay       Int?          @map("closing_day") // Day of month (1-31) - fechamento da fatura
  bestDayOffset    Int?          @map("best_day_offset") // DEPRECATED, ignored: the best day to buy is the closing day (closingDay, or dueDay - 7 when null)
  linkedAccountId  String?       @map("linked_account_id") @db.Uuid // Conta bancária vinculada (para herdar cor)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  household             Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  linkedAccount         Account?               @relation("LinkedAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)
  linkedCreditCards     Account[]              @relation("LinkedAccount") // Cartões vinculados a esta conta
  transactions          Transaction[]          @relation("TransactionAccount")
  fromTransactions      Transaction[]          @relation("TransactionFromAccount")
  toTransactions        Transaction[]          @relation("TransactionToAccount")
  relatedTransactions   Transaction[]          @relation("TransactionRelatedAccount")
  recurringTransactions RecurringTransaction[]
  savingsGoals          SavingsGoal[]
  captureAccountRules   CaptureAccountRule[]
  monthClosings         MonthClosing[]
  employments           Employment[]
  employmentItems       EmploymentItem[]

  // Indexes
  @@index([householdId])
  @@map("accounts")
}

enum CategoryType {
  INCOME
  EXPENSE
}

// How a budget is measured: the full spending (kept together) or the own share (kept separately)
enum BudgetMeasure {
  WHOLE
  OWN_SHARE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ALLOCATION
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum CategoryName {
  // Income categories
  SALARY
  FREELANCE
  INVESTMENTS
  SALES
  RENTAL_INCOME
  OTHER_INCOME

  // Expense categories
  FOOD
  TRANSPORTATION
  HOUSING
  HEALTHCARE
  EDUCATION
  ENTERTAINMENT
  CLOTHING
  UTILITIES
  SUBSCRIPTIONS
  ONLINE_SHOPPING
  GROCERIES
  RESTAURANT
  FUEL
  PHARMACY
  OTHER_EXPENSES

  // Internal movement categories
  TRANSFER
  ALLOCATION
}

// User-created categories (custom). System categories use CategoryName enum.
// categoryName in Transaction/Budget/Recurring: enum value (e.g. FOOD) or "CUSTOM:<id>"
model Category {
  id          String       @id @default(uuid()) @db.Uuid
  householdId String       @map("household_id") @db.Uuid
  name        String       @db.VarChar(100)
  type        CategoryType // INCOME or EXPENSE only
  icon        String?      @db.VarChar(50)
  color       String?      @db.VarChar(7) // Hex, e.g. #3B82F6
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name, type])
  @@index([householdId])
  @@index([householdId, type])
  @@map("categories")
}

model Transaction {
  id                     String          @id @default(uuid()) @db.Uuid
  householdId            String          @map("household_id") @db.Uuid
  type                   TransactionType @default(INCOME) // Tipo de transação: INCOME, EXPENSE, TRANSFER, ALLOCATION
  accountId              String?         @map("account_id") @db.Uuid // Para INCOME/EXPENSE
  categoryName           String?         @map("category_name") @db.VarChar(50) // Nullable para TRANSFER/ALLOCATION
  amount                 Decimal         @db.Decimal(15, 2)
  description            String?
  date                   DateTime        @db.Date
  notes                  String?
  paid                   Boolean         @default(true) // Flag para indicar se a transação já foi paga/recebida
  // Transfer fields
  fromAccountId          String?         @map("from_account_id") @db.Uuid // Conta origem (para TRANSFER)
  toAccountId            String?         @map("to_account_id") @db.Uuid // Conta destino (para TRANSFER)
  // Allocation fields
  relatedEntityId        String?         @map("related_entity_id") @db.Uuid // ID da entidade relacionada (ex: cartão de crédito para ALLOCATION)
  // Recurring transaction reference
  recurringTransactionId String?         @map("recurring_transaction_id") @db.Uuid
  // Installment fields
  installmentId          String?         @map("installment_id")
  installmentNumber      Int?            @map("installment_number")
  totalInstallments      Int?            @map("total_installments")
  attachmentUrl          String?         @map("attachment_url")
  // Split expense fields
  isSplit                Boolean         @default(false) @map("is_split") // Indica se a transação é dividida entre membros
  // Import provenance: stable id of the source row (e.g. maxfin:2026-10:credit:27, ofx:<fitid>:<hash>). Unique per household
  // (NULLs allowed, so manual transactions are unaffected): exact dedup, idempotent re-import and race-proof double submits
  sourceRef              String?         @map("source_ref") @db.VarChar(120)
  // Reference month ('YYYY-MM') when the money belongs to a different month than the day it moves (a meal voucher
  // deposited on 25 Sep that pays October). Null = the month of `date`. Balances, calendar, invoices and bank
  // reconciliation keep using `date`; month planning (lists by month, summaries, budgets) uses COALESCE(competence_month, month of date).
  competenceMonth        String?         @map("competence_month") @db.VarChar(7)
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  // Relations
  household            Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account              Account?              @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: SetNull)
  fromAccount          Account?              @relation("TransactionFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccount            Account?              @relation("TransactionToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  relatedAccount       Account?              @relation("TransactionRelatedAccount", fields: [relatedEntityId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  splits                TransactionSplit[]    // Divisões da transação entre membros
  externalRefs          TransactionExternalRef[] // Linhas externas (ex.: OFX da fatura) que esta transação já representa
  shares                TransactionShare[] // Partes de outras pessoas (despesas compartilhadas, sem exigir conta de usuário)
  settlement            Settlement? // Acerto de pessoa ao qual esta transação está vinculada
  capturedNotifications CapturedNotification[] // Notificações do banco que originaram esta transação

  // Indexes for common queries
  @@index([householdId])
  @@index([householdId, date])
  @@index([householdId, competenceMonth])
  @@index([householdId, categoryName])
  @@index([householdId, type])
  @@index([accountId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([relatedEntityId])
  @@index([date])
  @@index([recurringTransactionId])
  @@index([installmentId])
  @@unique([householdId, sourceRef])
  @@map("transactions")
}

// External lines (e.g. card invoice OFX lines, ref `ofx:<FITID>:<hash>`) a transaction already represents. One
// transaction may represent several lines (a sheet row covering a prepaid plan or a sum of purchases); a ref is
// recorded once per household, so re-importing the same file finds every line already reconciled.
model TransactionExternalRef {
  id            String   @id @default(uuid()) @db.Uuid
  householdId   String   @map("household_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  ref           String   @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([householdId, ref])
  @@index([transactionId])
  @@map("transaction_external_refs")
}

// ============================================================================
// BUDGETING & GOALS
// ============================================================================

model Budget {
  id           String       @id @default(uuid()) @db.Uuid
  householdId  String       @map("household_id") @db.Uuid
  categoryName String       @map("category_name") @db.VarChar(50)
  monthlyLimit Decimal      @map("monthly_limit") @db.Decimal(15, 2)
  month        DateTime     @db.Date // First month this budget is in force (start of month); it repeats in the next ones
  endMonth     DateTime?    @map("end_month") @db.Date // Last month in force (start of month); null = no end
  type         CategoryType // INCOME or EXPENSE
  measure      BudgetMeasure @default(WHOLE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // One budget per category per household per month
  @@unique([householdId, categoryName, month])
  @@index([householdId])
  @@index([householdId, month])
  @@map("budgets")
}

model SavingsGoal {
  id            String    @id @default(uuid()) @db.Uuid
  householdId   String    @map("household_id") @db.Uuid
  accountId     String?   @map("account_id") @db.Uuid
  name          String
  targetAmount  Decimal   @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(15, 2)
  targetDate    DateTime? @map("target_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([householdId])
  @@index([accountId])
  @@map("savings_goals")
}

// ============================================================================
// RECURRING TRANSACTIONS
// ============================================================================

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

// Whether the early-payment discount of a recurrence is a fixed value in reais or a percentage (see modules/recurring-transactions/early-discount.ts).
enum EarlyDiscountType {
  FIXED
  PERCENT
}

// How the amount of the next occurrence is forecast (see modules/recurring-transactions/expected-amount.ts).
enum ForecastStrategy {
  LAST
  FIXED
  CONSERVATIVE
  PER_BUSINESS_DAY
}

model RecurringTransaction {
  id           String              @id @default(uuid()) @db.Uuid
  householdId  String              @map("household_id") @db.Uuid
  accountId    String              @map("account_id") @db.Uuid
  categoryName String              @map("category_name") @db.VarChar(50)
  amount       Decimal             @db.Decimal(15, 2)
  description  String?
  frequency    RecurrenceFrequency
  startDate    DateTime            @map("start_date") @db.Date
  endDate      DateTime?           @map("end_date") @db.Date
  nextRunAt    DateTime            @map("next_run_at") @db.Date
  lastRunDate  DateTime?           @map("last_run_date") @db.Date
  isActive     Boolean             @default(true) @map("is_active")
  // When true, editing the most recent occurrence updates `amount` (predict the next value as the last real one)
  followLastAmount Boolean         @default(false) @map("follow_last_amount")
  // Months between the occurrence date and the month it refers to (1 = the following month); null = same month.
  competenceOffsetMonths Int?      @map("competence_offset_months")
  // Forecast strategy of the occurrence amount. LAST (default) keeps the behaviour that existed before the column.
  forecastStrategy ForecastStrategy @default(LAST) @map("forecast_strategy")
  // CONSERVATIVE: how many confirmed occurrences to look at (null = 6 for income, 3 for expense).
  forecastWindow Int?              @map("forecast_window")
  // PER_BUSINESS_DAY: amount per business day, business days to discount from the month, and the recurrence's own
  // "dias sem vale" ('MM-DD' every year or 'YYYY-MM-DD') and optional holidays ('CARNIVAL', 'CORPUS_CHRISTI').
  dailyRate    Decimal?            @map("daily_rate") @db.Decimal(15, 2)
  safetyBusinessDays Int           @default(0) @map("safety_business_days")
  nonWorkingDays String[]          @default([]) @map("non_working_days")
  optionalHolidays String[]        @default([]) @map("optional_holidays")
  // Other names the bank or the card machine uses for this charge ("Pg *Motoseguro Conecta"): an imported transaction
  // whose normalized description equals the name or one alias is taken by the recurrence instead of duplicated.
  aliases      String[]            @default([]) @map("aliases")
  // Early-payment discount: paid up to `earlyDiscountDay` of the occurrence's month the amount is reduced by a fixed value
  // or a percentage (rounded up to the cent). All three columns are set together, or none (no discount).
  earlyDiscountDay   Int?              @map("early_discount_day")
  earlyDiscountType  EarlyDiscountType? @map("early_discount_type")
  earlyDiscountValue Decimal?          @map("early_discount_value") @db.Decimal(15, 2)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // Relations
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  employment   Employment?
  employmentItem EmploymentItem?

  // Indexes
  // REGRA DE NEGÓCIO: Índice em nextRunAt para otimizar busca do cronjob
  // O cronjob busca apenas recorrências com nextRunAt <= hoje
  @@index([householdId])
  @@index([nextRunAt])
  @@index([isActive, nextRunAt])
  @@map("recurring_transactions")
}

// ============================================================================
// TRANSACTION SPLIT (Expense Sharing)
// ============================================================================

model TransactionSplit {
  id            String    @id @default(uuid()) @db.Uuid
  transactionId String    @map("transaction_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  amount        Decimal   @db.Decimal(15, 2) // Valor que este usuário deve pagar
  paid          Boolean   @default(false) // Se já foi pago
  paidAt        DateTime? @map("paid_at") // Data do pagamento
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([transactionId, userId]) // Um usuário só pode ter uma divisão por transação
  @@index([transactionId])
  @@index([userId])
  @@index([paid])
  @@map("transaction_splits")
}

// ============================================================================
// PEOPLE & SHARED EXPENSES (the other side of a split does not need a Recta account)
// ============================================================================

enum ShareDirection {
  THEY_OWE_ME // I paid and the person owes me their part
  I_OWE_THEM // I owe the person this amount
}

enum SettlementDirection {
  RECEIVED // the person paid me
  PAID // I paid the person
}

model Person {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  name        String   @db.VarChar(100)
  userId      String?  @map("user_id") @db.Uuid // Optional link to a Recta user
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  aliases     PersonAlias[]
  shares      TransactionShare[]
  settlements Settlement[]
  employments Employment[]

  @@index([householdId])
  @@map("people")
}

// Every lookup key of a person: its name (isName) and its nicknames. `key` is the label under normalizeLabel
// (lower case, no accents, single spaces); unique per household so names and aliases never collide, whatever the race.
model PersonAlias {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  personId    String   @map("person_id") @db.Uuid
  label       String   @db.VarChar(100)
  key         String   @db.VarChar(100)
  isName      Boolean  @default(false) @map("is_name")
  createdAt   DateTime @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([householdId, key])
  @@index([personId])
  @@map("person_aliases")
}

// A person's part of a transaction. Not a TransactionSplit: the person has no account and nothing is debited from anyone.
model TransactionShare {
  id            String         @id @default(uuid()) @db.Uuid
  householdId   String         @map("household_id") @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  personId      String         @map("person_id") @db.Uuid
  amount        Decimal        @db.Decimal(12, 2)
  direction     ShareDirection
  source        String         @default("manual") @db.VarChar(10) // manual | import
  note          String?        @db.VarChar(500)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  person      Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([transactionId, personId, direction])
  @@index([householdId, personId])
  @@index([transactionId])
  @@map("transaction_shares")
}

// Money that changed hands with a person. Optionally linked (at most once) to the real transaction behind it; deleting
// the settlement keeps the transaction, deleting the transaction only unlinks the settlement.
model Settlement {
  id            String              @id @default(uuid()) @db.Uuid
  householdId   String              @map("household_id") @db.Uuid
  personId      String              @map("person_id") @db.Uuid
  direction     SettlementDirection
  amount        Decimal             @db.Decimal(12, 2)
  date          DateTime            @db.Date
  transactionId String?             @unique @map("transaction_id") @db.Uuid
  note          String?             @db.VarChar(500)
  createdAt     DateTime            @default(now()) @map("created_at")

  // Relations
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([householdId, personId])
  @@map("settlements")
}

// ============================================================================
// USER FEEDBACK
// ============================================================================

model UserFeedback {
  id              String   @id @default(uuid()) @db.Uuid
  email           String
  score           Int // 1 to 5 stars
  feedbackContent String?  @map("feedback_content") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("user_feedback")
}

// ============================================================================
// REFERRALS
// ============================================================================

model Referral {
  id           String   @id @default(uuid()) @db.Uuid
  referrerId   String   @map("referrer_id") @db.Uuid // User who referred
  referredId   String   @map("referred_id") @db.Uuid // User who was referred
  referralCode String   @map("referral_code") @db.VarChar(20) // The code used
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  // One referral per referred user (prevent duplicates)
  @@unique([referredId])
  @@index([referrerId])
  @@index([referredId])
  @@index([referralCode])
  @@map("referrals")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

enum NotificationType {
  HOUSEHOLD_INVITE
  BUDGET_ALERT
  TRANSACTION_REMINDER
  GOAL_UPDATE
  // Future types can be added here
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  type        NotificationType
  status      NotificationStatus @default(UNREAD)
  title       String
  message     String
  metadata    Json?              // Flexible data for different notification types (e.g., { inviteId, householdId, etc. })
  deepLink    String?            @map("deep_link") // Deep link URL (e.g., /app/notifications/:id or /households/:id/invites/:inviteId)
  readAt      DateTime?          @map("read_at")
  archivedAt  DateTime?          @map("archived_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  expiresAt   DateTime?          @map("expires_at") // Optional expiration (for invites, etc.)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId])
  @@index([userId, status])
  @@index([userId, type])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// NOTIFICATION CAPTURES (Android app)
// ============================================================================

enum CaptureStatus {
  PENDING
  CONFIRMED
  DISMISSED
  IGNORED
}

// Raw text of a bank push notification sent by the Android app. Stored as received (parsing comes later and only
// fills `parsed`). `dedupKey` = sha1(package | postedAt to the minute | title | text): unique per household, so a
// retry or a double submit of the same notification is a no-op.
model CapturedNotification {
  id            String        @id @default(uuid()) @db.Uuid
  householdId   String        @map("household_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  package       String        @db.VarChar(150)
  title         String?       @db.VarChar(300)
  text          String        @db.VarChar(2000)
  postedAt      DateTime      @map("posted_at") @db.Timestamptz(3)
  dedupKey      String        @map("dedup_key") @db.VarChar(40)
  status        CaptureStatus @default(PENDING)
  parsed        Json?
  parserVersion Int?          @map("parser_version")
  transactionId String?       @map("transaction_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([householdId, dedupKey])
  @@index([householdId, status, postedAt])
  @@map("captured_notifications")
}

// Long-lived, revocable credential of one device, limited to POST /captures. Only the SHA-256 of the token is stored;
// the plain token (`rdt_...`) is shown once, when the device is created.
model DeviceToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  householdId String    @map("household_id") @db.Uuid
  name        String    @db.VarChar(100)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// Which Recta account receives each kind of capture of an app (e.g. Nubank card purchase -> Nubank card account).
model CaptureAccountRule {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  package     String   @db.VarChar(150)
  kind        String   @db.VarChar(30)
  accountId   String   @map("account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([householdId, package, kind])
  @@map("capture_account_rules")
}

// ============================================================================
// PAYROLL (CLT employment: salary history, fixed items, vacations, FGTS)
// Read/forecast only: nothing here creates a transaction or touches a balance.
// ============================================================================

// DEDUCTION: rate x base minus the band's "parcela a deduzir"; DIRECT: sum of each band's slice x its rate.
enum PayrollBracketMethod {
  DEDUCTION
  DIRECT
}

enum PayrollRounding {
  TRUNCATE
  ROUND
}

enum PayrollItemKind {
  EARNING
  DEDUCTION
}

// How an employment item is calculated: a fixed monthly value, or a value per business day of the reference month.
enum PayrollItemCalc {
  FIXED_MONTHLY
  PER_BUSINESS_DAY
}

// Work regime of the employment. Only CLT has payroll calculation; others can be added later.
enum EmploymentRegime {
  CLT
}

// How the FGTS can be withdrawn: at termination (default) or the yearly birthday withdrawal.
enum FgtsMode {
  TERMINATION
  BIRTHDAY
}

enum FgtsWithdrawalKind {
  BIRTHDAY
  TERMINATION
  OTHER
}

model Employment {
  id                     String               @id @default(uuid()) @db.Uuid
  householdId            String               @map("household_id") @db.Uuid
  regime                 EmploymentRegime     @default(CLT)
  employer               String               @db.VarChar(120)
  admissionDate          DateTime             @map("admission_date") @db.Date
  // Last day of the employment; null = still employed.
  endDate                DateTime?            @map("end_date") @db.Date
  dependents             Int                  @default(0)
  // Day of the month the salary is paid; the forecast pays the competence month in this day of the NEXT month.
  payDay                 Int                  @default(5) @map("pay_day")
  // Account that receives the money (where it stays available); null = the recurrence's account.
  accountId              String?              @map("account_id") @db.Uuid
  // The "Salary" income recurrence this employment feeds (its monthly amount comes from the calculation).
  recurringTransactionId String?              @unique @map("recurring_transaction_id") @db.Uuid
  bracketMethod          PayrollBracketMethod @default(DEDUCTION) @map("bracket_method")
  rounding               PayrollRounding      @default(TRUNCATE)
  thirteenthFirstMonth   Int                  @default(6) @map("thirteenth_first_month")
  thirteenthFirstDay     Int                  @default(30) @map("thirteenth_first_day")
  thirteenthSecondMonth  Int                  @default(12) @map("thirteenth_second_month")
  thirteenthSecondDay    Int                  @default(20) @map("thirteenth_second_day")
  // Owner of the employment (a Person of the household); null on rows created before the owner existed.
  personId               String?              @map("person_id") @db.Uuid
  // Holiday calendar: UF and city (null UF = weekends only). Optional days (carnival, Corpus Christi) count as days off when true.
  holidayUf              String?              @map("holiday_uf") @db.VarChar(2)
  holidayCity            String?              @map("holiday_city") @db.VarChar(80)
  optionalHolidaysOff    Boolean              @default(false) @map("optional_holidays_off")
  isActive               Boolean              @default(true) @map("is_active")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  household            Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  person               Person?                    @relation(fields: [personId], references: [id], onDelete: Restrict)
  account              Account?                   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction?      @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  salaries             EmploymentSalary[]
  items                EmploymentItem[]
  vacations            EmploymentVacation[]
  fgtsBalances         EmploymentFgtsBalance[]
  fgtsModes            EmploymentFgtsMode[]
  fgtsWithdrawals      EmploymentFgtsWithdrawal[]

  @@index([householdId])
  @@index([personId])
  @@map("employments")
}

// Gross salary in force from `startDate` until the next entry.
model EmploymentSalary {
  id           String   @id @default(uuid()) @db.Uuid
  employmentId String   @map("employment_id") @db.Uuid
  amount       Decimal  @db.Decimal(15, 2)
  startDate    DateTime @map("start_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@unique([employmentId, startDate])
  @@map("employment_salaries")
}

// A fixed earning or deduction of the payslip (for instance an allowance outside the tax bases).
model EmploymentItem {
  id           String          @id @default(uuid()) @db.Uuid
  employmentId String          @map("employment_id") @db.Uuid
  name         String          @db.VarChar(100)
  kind         PayrollItemKind @default(EARNING)
  inInssBase   Boolean         @default(false) @map("in_inss_base")
  inIrrfBase   Boolean         @default(false) @map("in_irrf_base")
  inFgtsBase   Boolean         @default(false) @map("in_fgts_base")
  // PER_BUSINESS_DAY: the value history is the value per day; the fields below apply only to it.
  calcMode               PayrollItemCalc @default(FIXED_MONTHLY) @map("calc_mode")
  marginDays             Int             @default(0) @map("margin_days")
  payDay                 Int?            @map("pay_day")
  // Reference month minus payment month, in months (1 = paid the month before the days it counts).
  referenceMonthOffset   Int             @default(0) @map("reference_month_offset")
  accountId              String?         @map("account_id") @db.Uuid
  isAvailableCash        Boolean         @default(true) @map("is_available_cash")
  recurringTransactionId String?         @unique @map("recurring_transaction_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  employment           Employment            @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  account              Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  values               EmploymentItemValue[]

  @@index([employmentId])
  @@map("employment_items")
}

model EmploymentItemValue {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  amount    Decimal  @db.Decimal(15, 2)
  startDate DateTime @map("start_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  item EmploymentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, startDate])
  @@map("employment_item_values")
}

// A marked vacation: exact start date, or only the month (then 30 days from day 1, estimated).
model EmploymentVacation {
  id           String    @id @default(uuid()) @db.Uuid
  employmentId String    @map("employment_id") @db.Uuid
  startDate    DateTime? @map("start_date") @db.Date
  month        String?   @db.VarChar(7) // 'YYYY-MM', only when startDate is null
  days         Int?
  sellDays     Int       @default(0) @map("sell_days")
  note         String?   @db.VarChar(200)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employment Employment               @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  items      EmploymentVacationItem[]

  @@index([employmentId])
  @@map("employment_vacations")
}

// One-off line paid with a vacation (for instance the advance of a raise).
model EmploymentVacationItem {
  id         String          @id @default(uuid()) @db.Uuid
  vacationId String          @map("vacation_id") @db.Uuid
  label      String          @db.VarChar(100)
  amount     Decimal         @db.Decimal(15, 2)
  kind       PayrollItemKind @default(EARNING)
  inInssBase Boolean         @default(false) @map("in_inss_base")
  inIrrfBase Boolean         @default(false) @map("in_irrf_base")
  inFgtsBase Boolean         @default(false) @map("in_fgts_base")

  vacation EmploymentVacation @relation(fields: [vacationId], references: [id], onDelete: Cascade)

  @@index([vacationId])
  @@map("employment_vacation_items")
}

// FGTS balance reported by the user (statement), on a date.
model EmploymentFgtsBalance {
  id           String   @id @default(uuid()) @db.Uuid
  employmentId String   @map("employment_id") @db.Uuid
  amount       Decimal  @db.Decimal(15, 2)
  asOfDate     DateTime @map("as_of_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@unique([employmentId, asOfDate])
  @@map("employment_fgts_balances")
}

// FGTS withdrawal (birthday or other): only recorded, never forecast.
model EmploymentFgtsWithdrawal {
  id           String             @id @default(uuid()) @db.Uuid
  employmentId String             @map("employment_id") @db.Uuid
  amount       Decimal            @db.Decimal(15, 2)
  date         DateTime           @db.Date
  kind         FgtsWithdrawalKind @default(OTHER)
  note         String?            @db.VarChar(200)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@index([employmentId, date])
  @@map("employment_fgts_withdrawals")
}

// FGTS withdrawal mode in force from `startDate` (it can change during the contract). For BIRTHDAY the month of the
// birthday is kept; `expectedAmount` is an optional user-informed forecast of that withdrawal (overrides the table).
model EmploymentFgtsMode {
  id             String   @id @default(uuid()) @db.Uuid
  employmentId   String   @map("employment_id") @db.Uuid
  mode           FgtsMode
  birthdayMonth  Int?     @map("birthday_month")
  expectedAmount Decimal? @map("expected_amount") @db.Decimal(15, 2)
  startDate      DateTime @map("start_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@unique([employmentId, startDate])
  @@map("employment_fgts_modes")
}

// Month close: the user's conference of one account (or card) for one month. `informedBalance` is what the statement says
// (the bank's balance on the last day; for a card, the invoice total), `systemBalance` what the system computed at that
// moment, `difference` = informed - system. One row per (household, month, account): conferring again replaces it.
// It never blocks or edits the month's entries; the read route only warns when something of the month changed afterwards.
model MonthClosing {
  id              String   @id @default(uuid()) @db.Uuid
  householdId     String   @map("household_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  month           String   @db.VarChar(7) // 'YYYY-MM'
  informedBalance Decimal  @map("informed_balance") @db.Decimal(15, 2)
  systemBalance   Decimal  @map("system_balance") @db.Decimal(15, 2)
  difference      Decimal  @db.Decimal(15, 2)
  closedByUserId  String?  @map("closed_by_user_id") @db.Uuid
  closedAt        DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([householdId, month, accountId])
  @@index([householdId, month])
  @@map("month_closings")
}
